{
    "compilerOptions": {
        "lib": [
            "es5",
            "es6",
            "es2021",
            "dom"
        ],
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true
    },
    "include": [
        "src"
    ]
}
